# E2E Test Configuration
# Copy this file to .env and modify for your system:
#   cp .env.example .env

# ============================================
# REQUIRED: KSP installation directory
# ============================================
# This is the only required setting - all other paths are derived from this
# Do NOT include a trailing slash

# macOS (Steam on external drive):
KSP_DIR=/Volumes/Flatty/SteamLibrary/steamapps/common/Kerbal Space Program

# macOS (Steam default):
# KSP_DIR=$HOME/Library/Application Support/Steam/steamapps/common/Kerbal Space Program

# Linux (Steam):
# KSP_DIR=$HOME/.steam/steam/steamapps/common/Kerbal Space Program

# Windows (WSL accessing Windows Steam):
# KSP_DIR=/mnt/c/Program Files (x86)/Steam/steamapps/common/Kerbal Space Program

# ============================================
# OPTIONAL: Override auto-detected paths
# ============================================

# ksp-mcp project location (defaults to sibling directory of kOS.MechJeb2.Addon)
# KSP_MCP_DIR=/path/to/ksp-mcp

# Player.log location (auto-detected based on OS)
# macOS: $HOME/Library/Logs/Squad/KSP/Player.log
# Linux: $HOME/.config/unity3d/Squad/Kerbal Space Program/Player.log
# PLAYER_LOG=/custom/path/to/Player.log

# KSP executable (auto-detected based on OS)
# macOS: $KSP_DIR/KSP.app
# Linux: $KSP_DIR/KSP.x86_64
# KSP_APP=/custom/path/to/KSP

# Timeout command (auto-detected: gtimeout on macOS, timeout on Linux)
# TIMEOUT_CMD=/usr/local/bin/gtimeout
